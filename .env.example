# 本番は GitHub Secrets に登録する（公開リポジトリのためコードへの直書き禁止）

# --- Phase 1: 配信 ---
# Discord の #tech-reader チャンネルで作成した Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy

# --- Phase 2: リアクション付与と Notion 転記 ---
# Discord Developer Portal で作成した Bot のトークン
DISCORD_BOT_TOKEN=xxxxxxxx
# #tech-reader チャンネルのID（開発者モードで右クリック → チャンネルIDをコピー）
DISCORD_CHANNEL_ID=123456789012345678
# サーバーのID（サーバー名を右クリック → サーバーIDをコピー）。
# Notion に貼るメッセージのリンク生成にのみ使うため、未設定でも転記は動く
DISCORD_GUILD_ID=123456789012345678
# Notion の内部インテグレーションのシークレット（ntn_ で始まる）
NOTION_TOKEN=ntn_xxxxxxxx
# tech-reader ナレッジDB のID（URLの /p/ 以降32桁）
NOTION_DATABASE_ID=0d3be6a38e2b48749d6c7769c967726b
